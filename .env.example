# Copie para .env e TROQUE os valores. O arquivo .env não vai para o git.
# Use só letras e números nas senhas (elas entram na DATABASE_URL).
# Atenção: as senhas são gravadas no banco na PRIMEIRA subida. Para trocá-las depois,
# apague os volumes (docker compose down -v), o que apaga também os dados.

# Superusuário de administração dos 4 PostgreSQL (não usado pelas aplicações)
PG_ADMIN_PASSWORD=troque_admin

# Usuário de aplicação de cada banco (app_<serviço>)
EDITAIS_DB_PASSWORD=troque_editais
OFERTAS_DB_PASSWORD=troque_ofertas
COMPRAS_DB_PASSWORD=troque_compras
ENTREGAS_DB_PASSWORD=troque_entregas
