# Arquivos executados dentro de contêineres Linux precisam de fim de linha LF,
# mesmo com core.autocrlf=true no Windows (CRLF quebra scripts sh).
*.sh           text eol=lf
*.sql          text eol=lf
*.conf         text eol=lf
Dockerfile*    text eol=lf
*.yml          text eol=lf
*.py           text eol=lf
