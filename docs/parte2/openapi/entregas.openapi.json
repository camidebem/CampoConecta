    "/entregas/{id}/recebimentos": {
      "post": {
        "tags": [
          "entregas"
        ],
        "operationId": "confirmarRecebimento",
        "summary": "Confirmar recebimento pela escola",
        "description": "Papéis permitidos: escola. Exige papel escola e instituicaoId igual a escolaId da entrega; gestor e produtor recebem 403. Somente AGENDADA → RECEBIDA. Ator e instante gerados pelo servidor; confirmação única por entrega. Grava recebimento e EntregaRecebida na outbox na mesma transação local. A Compra e o pagamento podem atrasar; não são alterados por HTTP. Nova chave para entrega recebida: 409; mesma chave/corpo devolve o 201 original.",
        "x-papeis": [
          "escola"
        ],
        "x-autorizacao": "Exige papel escola e instituicaoId igual a escolaId da entrega; gestor e produtor recebem 403.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "$ref": "#/components/parameters/Id"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "description": "Recurso criado e persistido.",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Identificador propagado."
              },
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                },
                "description": "Caminho relativo na API do serviço; o BFF reescreve o prefixo externo.",
                "example": "/api/v1/entregas/00000015-0000-4000-8000-000000000001/recebimentos"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmacaoRecebimento"
                },
                "example": {
                  "id": "00000017-0000-4000-8000-000000000001",
                  "entregaId": "00000015-0000-4000-8000-000000000001",
                  "confirmadoPor": "00000018-0000-4000-8000-000000000001",
                  "confirmadoEm": "2026-11-25T10:30:00-03:00"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "403": {
            "$ref": "#/components/responses/Erro403"
          },
          "404": {
            "$ref": "#/components/responses/Erro404"
          },
          "409": {
