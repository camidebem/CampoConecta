    "/entregas": {
      "get": {
        "tags": [
          "entregas"
        ],
        "operationId": "listarEntregas",
        "summary": "Listar entregas",
        "description": "Papéis permitidos: gestor, escola, produtor. Gestor: entregas da própria prefeitura; escola: instituicaoId igual a escolaId; produtor: produtorId igual ao da entrega. Vínculos são autoritativos, conforme conciliação ADR 0006. Ordenação estável por id ascendente. Filtros combinados com AND; autorização aplicada antes de contar/paginar.",
        "x-papeis": [
          "gestor",
          "escola",
          "produtor"
        ],
        "x-autorizacao": "Gestor: entregas da própria prefeitura; escola: instituicaoId igual a escolaId; produtor: produtorId igual ao da entrega. Vínculos são autoritativos, conforme conciliação ADR 0006.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "$ref": "#/components/parameters/Pagina"
          },
          {
            "$ref": "#/components/parameters/Tamanho"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Situação da entrega.",
            "schema": {
              "type": "string",
              "enum": [
                "AGENDADA",
                "RECEBIDA",
                "CANCELADA"
              ]
            },
            "example": "AGENDADA"
          },
          {
            "name": "escolaId",
            "in": "query",
            "required": false,
            "description": "Escola, dentro do escopo autorizado.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "00000002-0000-4000-8000-000000000001"
          },
          {
            "name": "compraId",
            "in": "query",
            "required": false,
            "description": "Compra relacionada.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "00000010-0000-4000-8000-000000000001"
          },
          {
            "name": "inicioDesde",
            "in": "query",
            "required": false,
            "description": "Início da janela maior ou igual ao instante.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-11-25T08:00:00-03:00"
          },
          {
            "name": "inicioAte",
            "in": "query",
            "required": false,
            "description": "Início da janela menor ou igual ao instante.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-11-25T17:00:00-03:00"
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Identificador propagado."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListarEntregasPagina"
                },
                "example": {
                  "items": [
                    {
                      "id": "00000015-0000-4000-8000-000000000001",
                      "compraId": "00000010-0000-4000-8000-000000000001",
                      "escolaId": "00000002-0000-4000-8000-000000000001",
                      "produtorId": "00000005-0000-4000-8000-000000000001",
                      "agendamentoId": "00000014-0000-4000-8000-000000000001",
                      "janela": {
                        "inicio": "2026-11-25T08:00:00-03:00",
                        "fim": "2026-11-25T17:00:00-03:00"
                      },
                      "status": "AGENDADA"
                    }
                  ],
                  "paginacao": {
                    "pagina": 1,
                    "tamanho": 20,
                    "total": 1,
                    "totalPaginas": 1
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "403": {
            "$ref": "#/components/responses/Erro403"
          },
          "503": {
            "$ref": "#/components/responses/Erro503"
          }
        }
      }
    },
