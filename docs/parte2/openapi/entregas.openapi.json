          },
          "503": {
            "$ref": "#/components/responses/Erro503"
          }
        },
        "requestBody": {
          "required": true,
          "description": "Corpo completo conforme schema; campos desconhecidos geram 400.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecebimentoCriacao"
              },
              "example": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT OIDC propagado internamente. Claims: sub, papel (gestor/escola/produtor), instituicaoId ou produtorId. Autenticação não substitui autorização por recurso."
      }
    },
    "schemas": {
      "Erro": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Código estável legível por máquina."
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Mensagem sem detalhes internos."
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "campo": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "Caminho do campo ou contexto."
                },
                "motivo": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "Motivo do erro."
                }
              },
              "required": [
                "campo",
                "motivo"
              ]
            },
            "minItems": 0
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "correlationId"
        ]
      },
      "Paginacao": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pagina": {
