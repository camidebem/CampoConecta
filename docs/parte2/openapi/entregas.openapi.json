{
  "openapi": "3.1.0",
  "info": {
    "title": "CampoConecta — Entregas",
    "version": "1.0.0",
    "description": "Contrato da API interna do CampoConecta, consumida pelos BFFs. Convenções em README.md e regras de integração propostas no ADR 0006. Componentes ainda não implantados."
  },
  "servers": [
    {
      "url": "http://entregas:8000/api/v1",
      "description": "Endereço interno proposto; porta de referência, sem implantação."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "capacidades",
      "description": "Recursos capacidades de CampoConecta — Entregas."
    },
    {
      "name": "entregas",
      "description": "Recursos entregas de CampoConecta — Entregas."
    }
  ],
  "paths": {
    "/capacidades": {
      "post": {
        "tags": [
          "capacidades"
        ],
        "operationId": "criarCapacidade",
        "summary": "Cadastrar capacidade logística",
        "description": "Papéis permitidos: gestor. Exige papel gestor e recurso pertencente à prefeitura indicada por instituicaoId. A escola vinculada ao recurso deve pertencer à mesma prefeitura. Janela futura, início < fim. Vínculo da escola é validado por contexto institucional confiável, ainda dependente da conciliação ADR 0006; não por nome/endereço de snapshot ou claim enviada livremente. Janelas sobrepostas para a mesma escola: 409. Não há consulta HTTP adicional de Entregas a Editais neste contrato.",
        "x-papeis": [
          "gestor"
        ],
        "x-autorizacao": "Exige papel gestor e recurso pertencente à prefeitura indicada por instituicaoId. A escola vinculada ao recurso deve pertencer à mesma prefeitura.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "description": "Recurso criado e persistido.",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Identificador propagado."
              },
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                },
                "description": "Caminho relativo na API do serviço; o BFF reescreve o prefixo externo.",
                "example": "/api/v1/capacidades/00000013-0000-4000-8000-000000000001"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capacidade"
                },
                "example": {
                  "id": "00000013-0000-4000-8000-000000000001",
                  "escolaId": "00000002-0000-4000-8000-000000000001",
                  "janela": {
                    "inicio": "2026-11-25T08:00:00-03:00",
                    "fim": "2026-11-25T17:00:00-03:00"
                  },
                  "capacidadeKg": "500.00",
                  "reservadoKg": "0.00",
                  "versao": 1
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "403": {
            "$ref": "#/components/responses/Erro403"
          },
          "409": {
            "$ref": "#/components/responses/Erro409"
          },
          "503": {
            "$ref": "#/components/responses/Erro503"
          }
        },
        "requestBody": {
          "required": true,
          "description": "Corpo completo conforme schema; campos desconhecidos geram 400.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CapacidadeCriacao"
              },
              "example": {
                "escolaId": "00000002-0000-4000-8000-000000000001",
                "janela": {
                  "inicio": "2026-11-25T08:00:00-03:00",
                  "fim": "2026-11-25T17:00:00-03:00"
                },
                "capacidadeKg": "500.00"
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "capacidades"
        ],
        "operationId": "listarCapacidades",
        "summary": "Listar capacidades",
        "description": "Papéis permitidos: gestor. Exige papel gestor e recurso pertencente à prefeitura indicada por instituicaoId. A escola vinculada ao recurso deve pertencer à mesma prefeitura. Ordenação estável por id ascendente. Filtros combinados com AND; autorização aplicada antes de contar/paginar.",
        "x-papeis": [
          "gestor"
        ],
        "x-autorizacao": "Exige papel gestor e recurso pertencente à prefeitura indicada por instituicaoId. A escola vinculada ao recurso deve pertencer à mesma prefeitura.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "$ref": "#/components/parameters/Pagina"
          },
          {
            "$ref": "#/components/parameters/Tamanho"
          },
          {
            "name": "escolaId",
            "in": "query",
            "required": false,
            "description": "Escola da janela.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "00000002-0000-4000-8000-000000000001"
          },
          {
            "name": "inicioDesde",
            "in": "query",
            "required": false,
            "description": "Limite inclusivo do início da janela.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-11-25T08:00:00-03:00"
          },
          {
            "name": "inicioAte",
            "in": "query",
            "required": false,
            "description": "Limite inclusivo do início da janela.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-11-25T17:00:00-03:00"
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Identificador propagado."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListarCapacidadesPagina"
                },
                "example": {
                  "items": [
                    {
                      "id": "00000013-0000-4000-8000-000000000001",
                      "escolaId": "00000002-0000-4000-8000-000000000001",
                      "janela": {
                        "inicio": "2026-11-25T08:00:00-03:00",
                        "fim": "2026-11-25T17:00:00-03:00"
                      },
                      "capacidadeKg": "500.00",
                      "reservadoKg": "100.00",
                      "versao": 1
                    }
                  ],
                  "paginacao": {
                    "pagina": 1,
                    "tamanho": 20,
                    "total": 1,
                    "totalPaginas": 1
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "403": {
            "$ref": "#/components/responses/Erro403"
          },
          "503": {
            "$ref": "#/components/responses/Erro503"
          }
        }
      }
    },
