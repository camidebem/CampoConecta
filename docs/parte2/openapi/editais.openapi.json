          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Mensagem sem detalhes internos."
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "campo": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "Caminho do campo ou contexto."
                },
                "motivo": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "Motivo do erro."
                }
              },
              "required": [
                "campo",
                "motivo"
              ]
            },
            "minItems": 0
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "correlationId"
        ]
      },
      "Paginacao": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pagina": {
            "type": "integer",
            "minimum": 1
          },
          "tamanho": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "totalPaginas": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "pagina",
          "tamanho",
          "total",
          "totalPaginas"
        ]
      },
      "Versao": {
        "type": "integer",
