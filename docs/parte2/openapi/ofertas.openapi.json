              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Identificador propagado."
              },
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                },
                "description": "Caminho relativo na API do serviço; o BFF reescreve o prefixo externo."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Produtor"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
