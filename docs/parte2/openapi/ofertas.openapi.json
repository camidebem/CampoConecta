  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT OIDC propagado internamente. Claims: sub, papel (gestor/escola/produtor), instituicaoId ou produtorId. Autenticação não substitui autorização por recurso."
      }
    },
    "schemas": {
      "Quantidade": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "valor": {
            "type": "string",
            "pattern": "^(0\\.(0[1-9]|[1-9][0-9])|[1-9][0-9]{0,11}\\.[0-9]{2})$",
            "description": "Decimal exato estritamente positivo, com duas casas."
          },
          "unidade": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "description": "Unidade compatível com o item/oferta; conversão implícita é proibida."
          }
        },
        "required": [
          "valor",
          "unidade"
        ]
      },
      "Saldo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "valor": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$",
            "description": "Decimal exato não negativo, com duas casas, transmitido como string. Não usar float."
          },
          "unidade": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "description": "Mesma unidade da quantidade original."
          }
        },
        "required": [
          "valor",
          "unidade"
        ]
      },
      "Erro": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Código estável legível por máquina."
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Mensagem sem detalhes internos."
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "campo": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "Caminho do campo ou contexto."
                },
                "motivo": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "Motivo do erro."
                }
              },
              "required": [
                "campo",
                "motivo"
              ]
            },
            "minItems": 0
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "correlationId"
        ]
      },
      "Paginacao": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pagina": {
            "type": "integer",
            "minimum": 1
          },
          "tamanho": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "totalPaginas": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "pagina",
          "tamanho",
          "total",
          "totalPaginas"
        ]
      },
      "Versao": {
        "type": "integer",
        "minimum": 1
      },
      "ProdutorCriacao": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Nome do produtor."
          },
          "documento": {
            "type": "string",
            "pattern": "^([0-9]{11}|[0-9]{14})$",
            "description": "CPF ou CNPJ sem pontuação, único."
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        },
        "required": [
          "nome",
          "documento",
          "email"
        ]
      },
      "Produtor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Nome do produtor."
          },
          "documento": {
            "type": "string",
            "pattern": "^([0-9]{11}|[0-9]{14})$",
            "description": "CPF ou CNPJ sem pontuação, único."
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "ativo": {
            "type": "boolean"
          },
          "versao": {
            "$ref": "#/components/schemas/Versao"
          }
        },
        "required": [
          "id",
          "nome",
          "documento",
          "email",
          "ativo",
          "versao"
        ]
      },
      "ProdutorAjuste": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "versao": {
            "$ref": "#/components/schemas/Versao"
          },
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Nome atualizado."
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "ativo": {
            "type": "boolean"
          }
        },
        "required": [
          "versao"
        ],
        "minProperties": 2
      },
      "OfertaCriacao": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "produtorId": {
            "type": "string",
            "format": "uuid"
          },
          "produto": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Produto ofertado."
          },
          "quantidadeDisponivel": {
            "$ref": "#/components/schemas/Quantidade"
          }
        },
        "required": [
          "produtorId",
          "produto",
          "quantidadeDisponivel"
        ]
      },
      "Oferta": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "produtorId": {
            "type": "string",
            "format": "uuid"
          },
          "produto": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Produto ofertado."
          },
          "quantidadeDisponivel": {
            "$ref": "#/components/schemas/Saldo"
          },
          "ativa": {
            "type": "boolean"
          },
          "versao": {
            "$ref": "#/components/schemas/Versao"
          }
        },
        "required": [
          "id",
          "produtorId",
          "produto",
          "quantidadeDisponivel",
          "ativa",
          "versao"
        ]
      },
      "OfertaAjuste": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "versao": {
            "$ref": "#/components/schemas/Versao"
          },
          "quantidadeDisponivel": {
            "$ref": "#/components/schemas/Saldo"
          },
          "ativa": {
            "type": "boolean"
          }
        },
        "required": [
          "versao"
        ],
        "minProperties": 2,
        "description": "Atualiza só o saldo livre, sem devolver ou consumir reservas existentes. Produto, unidade e produtor são imutáveis; unidade da quantidade deve permanecer igual. Inativação impede novas reservas, preservando compromissos existentes."
      },
      "Reserva": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ofertaId": {
            "type": "string",
            "format": "uuid"
          },
          "compraId": {
            "type": "string",
            "format": "uuid"
          },
          "quantidade": {
            "$ref": "#/components/schemas/Quantidade"
          },
          "status": {
            "type": "string",
            "enum": [
              "ATIVA",
              "LIBERADA"
            ]
          },
          "criadoEm": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "ofertaId",
          "compraId",
          "quantidade",
          "status",
          "criadoEm"
        ]
      },
      "ListarOfertasPagina": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Oferta"
            },
            "minItems": 0
          },
          "paginacao": {
            "$ref": "#/components/schemas/Paginacao"
          }
        },
        "required": [
          "items",
          "paginacao"
        ]
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "UUID do recurso no caminho.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "CorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": false,
        "description": "UUID de rastreamento; gerado se ausente e devolvido na resposta.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "UUID gerado pelo cliente. Escopo: sub autenticado + método + caminho normalizado. Reenvio idêntico retorna status/corpo/Location originais; conteúdo diferente ou operação ainda em curso: 409. Retenção mínima proposta: 30 dias.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Pagina": {
        "name": "pagina",
        "in": "query",
        "description": "Página iniciada em 1; além da última retorna items vazio.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "Tamanho": {
        "name": "tamanho",
        "in": "query",
        "description": "Limite de itens por página; valores fora do intervalo geram 400.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        }
      }
    },
    "responses": {
      "Erro400": {
        "description": "Corpo, parâmetro ou cabeçalho inválido, ausente ou não suportado.",
        "headers": {
          "X-Correlation-Id": {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador para rastreamento."
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            }
          }
        }
      },
      "Erro401": {
        "description": "Token ausente, expirado ou inválido.",
        "headers": {
          "X-Correlation-Id": {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador para rastreamento."
          },
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "description": "Desafio de autenticação Bearer."
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            }
          }
        }
      },
      "Erro403": {
        "description": "Papel ou vínculo não autoriza esta operação.",
        "headers": {
          "X-Correlation-Id": {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador para rastreamento."
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            }
          }
        }
      },
      "Erro404": {
        "description": "Recurso identificado não existe.",
        "headers": {
          "X-Correlation-Id": {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador para rastreamento."
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            }
          }
        }
      },
      "Erro409": {
        "description": "Estado, versão, unicidade, vínculo de negócio ou chave idempotente em conflito.",
        "headers": {
          "X-Correlation-Id": {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador para rastreamento."
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            }
          }
        }
      },
      "Erro503": {
        "description": "Dependência necessária indisponível. Não é garantia de ausência de efeito após perda da resposta; repetir com a mesma chave.",
        "headers": {
          "X-Correlation-Id": {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador para rastreamento."
          },
          "Retry-After": {
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Espera sugerida, em segundos, antes da repetição."
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            }
          }
        }
      }
    }
  }
}
