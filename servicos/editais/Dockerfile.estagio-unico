# Versão de COMPARAÇÃO, com um único estágio. Não é usada pelo docker-compose.
# Serve só para medir o ganho do multi-stage (scripts/medir-imagens.sh).
#
# Mesmas dependências e mesmo resultado funcional do Dockerfile principal, mas o
# compilador (build-essential), os headers (libpq-dev) e o cache do pip ficam
# na imagem final, porque tudo acontece no mesmo estágio.

FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libpq-dev \
 && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SERVICE_NAME=editais

WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY app ./app
COPY migrations ./migrations

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
